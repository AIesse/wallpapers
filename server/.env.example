# 服务端口
PORT=3000
# 本服务对外基址（API 与图片同源；图片由 server 从 GitHub 仓库代理分发，无需额外 CDN）
CDN_BASE=https://wallpaper.example.com
# 微信小程序
WX_APPID=wx0000000000000000
WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitHub JSON 数据库
GH_API=https://api.github.com        # 可改为 Cloudflare Worker 反代地址
GH_REPO=yourname/wallpaper-db
GH_BRANCH=main
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# 管理后台密码（访问 https://wallpaper.example.com/admin ，务必改成强密码）
ADMIN_PASSWORD=change-me-please
