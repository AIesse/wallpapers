<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab {{selected === index ? 'tab--on' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab__iconwrap">
      <image class="tab__icon" src="{{selected === index ? item.activeIcon : item.icon}}" />
    </view>
    <view class="tab__text">{{item.text}}</view>
  </view>
</view>
